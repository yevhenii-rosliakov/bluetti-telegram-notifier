# bluetti-grid-bot configuration. Copy to .env and fill in. Never commit .env.
# Only TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_IDS are required; run `login` for the BLUETTI token.

# ---------------------------------------------------------------- Telegram
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Chats that receive notifications, comma-separated. Group IDs are negative (-100...).
TELEGRAM_CHAT_IDS=123456789
# Chats allowed to use /status, /history, /help. Defaults to TELEGRAM_CHAT_IDS.
#TELEGRAM_ALLOWED_CHAT_IDS=

# ---------------------------------------------------------------- BLUETTI
# Refresh token printed by `bluetti-grid-bot login`. Only seeds the state database;
# the bot then stores the rotated token in STATE_DIR. Change it here to force a new one.
BLUETTI_REFRESH_TOKEN=
# Optional, for debugging only.
#BLUETTI_ACCESS_TOKEN=
# Data center: auto (probe and remember) | eu | global | us | full https:// URL.
BLUETTI_GATEWAY=auto
# Order in which `auto` probes gateways.
#BLUETTI_GATEWAY_PROBE_ORDER=eu,global,us
# Stations to monitor (serial numbers, comma-separated). Empty = all cloud-capable stations.
BLUETTI_DEVICE_SNS=
# Optional display names: SN1=Mom's flat,SN2=Garage (shown when several stations are monitored).
#BLUETTI_DEVICE_NAMES=
# OAuth client of the Home Assistant integration. Change only if you know why.
#BLUETTI_SSO_URL=https://sso.bluettipower.com
#BLUETTI_CLIENT_ID=HomeAssistant
#BLUETTI_CLIENT_SECRET=SG9tZUFzc2lzdGFudA==
#BLUETTI_REDIRECT_URI=https://my.home-assistant.io/redirect/oauth

# ---------------------------------------------------------------- Detection
# ats (station is the backup input of an ATS) | passthrough (loads always on the station)
# | grid_input (station always draws from the grid). See README "Choosing DETECTION_MODE".
DETECTION_MODE=ats
# Seconds between polls (min 15).
POLL_INTERVAL_SECONDS=60
# Watts: at or above = "there is load" / "grid input present".
LOAD_THRESHOLD_W=5
GRID_THRESHOLD_W=5
# passthrough mode: SOC drop (%) since grid was last seen that counts as "on battery".
SOC_DROP_PCT=2
# Consecutive polls needed before an outage / a restoration is reported.
DEBOUNCE_POLLS=2
RESTORE_DEBOUNCE_POLLS=2
# Seconds without data before "station offline" is reported.
OFFLINE_GRACE_SECONDS=600
# Low battery alerts while on battery (%), each once per outage. Empty disables.
LOW_SOC_THRESHOLDS=30,15
# Alert when the station's AC output is switched off.
ALERT_AC_OFF=true
# Send "Bot started ..." on startup. false = silent baseline unless on battery.
NOTIFY_STARTUP=true

# ---------------------------------------------------------------- Runtime
# uk | en
BOT_LANGUAGE=uk
# Time zone for times in messages, e.g. Europe/Kyiv.
TZ=Europe/Kyiv
# Where tokens, state and outage history (SQLite) live. /data in the container.
# For a local run without Docker, point it at a private directory, e.g. ./data
#STATE_DIR=/data
# DEBUG | INFO | WARNING | ERROR. DEBUG also logs serial numbers.
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
# Expose Prometheus metrics on /metrics.
METRICS_ENABLED=false
# Port for /healthz, /readyz, /metrics (0 disables the HTTP server).
HTTP_PORT=8080
